    {
      "id": "claim_d2345e8407cc42499d99799121f826e6",
      "statement": "ThreadManager tags each queued command with a monotonically increasing fence. Synchronous emulation forces a producer wait until that fence is signaled, while asynchronous submission can return after enqueueing. A CPU readback requests blocking submission even in asynchronous mode. This fence belongs to the emulated GPU worker queue; the host Vulkan scheduler has its own submission machinery.",
      "evidence": [
        {
          "resource": "repo://src/video_core/gpu_thread.cpp#L221-L252",
          "version": "repo-lines-v1:sha256:7f3173716dbb88e32ca398927b531db1a922c544c2dde1d0dc1ef5998489a903:"
        },
        {
