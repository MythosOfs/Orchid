          "version": "repo-lines-v1:sha256:6998009852b689fec59ff5acfdd9e0a062176a2b1418cc705dcdab955825aa6a:"
        }
      ]
    },
    {
      "id": "claim_1b8439a1880f44e5bafff6f9253c1abd",
      "statement": "The worker's regular submit path applies pending guest writes through GPU cache invalidation before handing the list and channel to the GPU scheduler. The CPU readback branch also invalidates before asking the rasterizer to download contents. Read this ordering when tracking stale constants or unexpected guest-visible GPU memory.",
      "evidence": [
